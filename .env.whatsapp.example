# Integration stays OFF until Meta onboarding, migration, template and end-to-end test.
WHATSAPP_BRIDGE_ENABLED=false
WHATSAPP_NOTIFICATIONS_ENABLED=false
# Generate independently; use the same value as n8n's HTTP Header Auth credential.
WHATSAPP_BRIDGE_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# Personal phone, country code included. Never commit its real value.
WHATSAPP_OWNER_PHONE=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_TEMPLATE_NAME=pauleta_nueva_solicitud
WHATSAPP_TEMPLATE_LANGUAGE=es
# Choose a currently supported JSON-output model on the existing OpenAI account.
WHATSAPP_AI_MODEL=
# Existing server environment also needs OPENAI_API_KEY, SUPABASE_SERVICE_ROLE_KEY,
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_APP_URL (HTTPS).
